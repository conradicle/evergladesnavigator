# Stripe — not active yet, infrastructure only (see src/lib/stripe.ts).
# Leaving these unset keeps the site in "booking request" mode with no
# live payments. Fill them in only once you're ready to accept real payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Contact / booking form destination — not wired to an email service yet
# (see src/app/actions/contact.ts and src/app/actions/booking.ts).
CONTACT_EMAIL=

# Snook Outlook (/snook): contact address sent in the User-Agent header to
# api.weather.gov, which asks API users for one. Works without it, but set it.
NWS_CONTACT_EMAIL=

# Snook trip log (/snook/log): passcode to open the log.
SNOOK_LOG_PASSCODE=

# Upstash Redis for the trip log. Connecting "Upstash for Redis" in Vercel's
# Storage tab adds these automatically; you don't type them in.
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work.)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared secret for the daily forecast snapshot cron (vercel.json). Vercel
# sends it automatically; the endpoint refuses every call while it's unset.
CRON_SECRET=
